{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": false,
    "noEmit": true,
    "types": ["node", "styled-jsx"]
  },
  "include": [
    "next-env.d.ts",
    "lib/commercial/followup-*.ts",
    "app/instagram-dashboard/commercial/CommercialFollowup.tsx",
    "app/api/instagram-dashboard/commercial/followup/**/*.ts",
    "app/api/instagram-dashboard/commercial/responses/**/*.ts",
    "app/api/instagram-dashboard/commercial/telephony/**/*.ts",
    "app/api/instagram-dashboard/commercial/calendly/**/*.ts",
    "app/api/instagram-dashboard/commercial/leads/*/followup/**/*.ts"
  ],
  "exclude": ["node_modules", "**/*.test.ts", "**/*.test.mjs"]
}
